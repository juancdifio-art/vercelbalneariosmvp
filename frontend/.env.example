# Variables de entorno del Frontend
# Copia este archivo a .env.local para desarrollo o .env.production para producción

# URL del backend API
VITE_API_URL=http://localhost:9000

# Chat de soporte (Tawk.to), opcional: "propiedad/widget", el final de la URL
# del embed (https://embed.tawk.to/<propiedad>/<widget>). Sin valor no se carga.
# En local conviene dejarlo vacio para no abrir chats de prueba.
# VITE_TAWK_ID=
